# Variáveis de ambiente do backend no Render (web service).
#
# O Render aceita colar este arquivo em "Add from .env" no painel do serviço.
# Sem comentário: o parser do Render é melhor quanto mais simples.
#
# Os dois segredos abaixo são POR SERVICE: gere novos com
#   head -c 48 /dev/urandom | base64   # JWT_SECRET
#   head -c 32 /dev/urandom | base64   # ADMIN_TOKEN
# Trocar o JWT_SECRET invalida todos os tokens (todo mundo loga de novo).

DATABASE_URL=postgresql://neondb_owner:SENHA@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=GERE_UM_TOKEN_COM_32_CARACTERES_OU_MAIS
ADMIN_TOKEN=GERE_UM_TOKEN_COM_24_CARACTERES_OU_MAIS
# Análise por IA do relatório mensal. Sem a chave, o relatório continua sendo
# gerado (só sem o texto da análise).
OPENROUTER_API_KEY=GERE_UMA_CHAVE_NO_OPENROUTER
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017:floor
# Mercado Pago. MP_ACCESS_TOKEN de produção começa com APP_USR- (token TEST-
# é sandbox: aceita cartão de teste e não entra dinheiro). MP_TOKEN_KEY cifra
# o token da conta do usuário no banco: gere com
#   head -c 32 /dev/urandom | base64
MP_ACCESS_TOKEN=APP_USR-COLE-O-TOKEN-DE-PRODUCAO
MP_PUBLIC_KEY=APP_USR-COLE-A-PUBLIC-KEY
MP_NOTIFICATION_URL=https://kavelipay-backend.onrender.com/webhooks/mercadopago
MP_CLIENT_ID=COLE-O-CLIENT-ID-DO-APP
MP_CLIENT_SECRET=COLE-O-CLIENT-SECRET-DO-APP
MP_TOKEN_KEY=GERE_UMA_CHAVE_COM_32_CARACTERES_OU_MAIS
DB_MAX_CONNECTIONS=10
RUST_LOG=info
