# Variáveis de ambiente do backend no Render (web service).
#
# O Render aceita colar este arquivo em "Add from .env" no painel do serviço.
# Sem comentário: o parser do Render é melhor quanto mais simples.
#
# Os dois segredos abaixo são POR SERVICE: gere novos com
#   head -c 48 /dev/urandom | base64   # JWT_SECRET
#   head -c 32 /dev/urandom | base64   # ADMIN_TOKEN
# Trocar o JWT_SECRET invalida todos os tokens (todo mundo loga de novo).

DATABASE_URL=postgresql://neondb_owner:SENHA@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=GERE_UM_TOKEN_COM_32_CARACTERES_OU_MAIS
ADMIN_TOKEN=GERE_UM_TOKEN_COM_24_CARACTERES_OU_MAIS
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-nemo
DB_MAX_CONNECTIONS=10
RUST_LOG=info
