<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        Só Android 8 e 9: a exportação da LGPD grava em Downloads por pasta
        pública e o sistema exige a permissão. Do Android 10 em diante a
        gravação é pela MediaStore, que não pede permissão — por isso o teto.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Escanear linha digitável do boleto. required=false: quem não tem
         câmera (ou nega) instala e usa o caminho de digitação manual. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:label="KaveliPay"
        android:supportsRtl="true"
        android:theme="@style/Theme.KaveliPay"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.KaveliPay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Link de cobrança: `kavelipay://cobranca/<token>`.
                 `singleTop` acima é o que faz um link com o app já aberto
                 chegar em `onNewIntent` em vez de abrir uma segunda Activity.
                 Isto NÃO é App Link https (não temos domínio) nem PIX: é um
                 esquema próprio do app, aberto só por quem tem o app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kavelipay" android:host="cobranca" />
            </intent-filter>
        </activity>
    </application>
</manifest>
